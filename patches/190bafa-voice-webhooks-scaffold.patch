+// Match against current MSISDN OR any archived MSISDN — covers in-flight
+// SMS/calls sent to a recently-rotated number. Shared by the SMS and voice
+// inbound webhooks below.
+async function findActiveNumberByMsisdn(msisdn: string) {
+  const [number] = await db
+    .select()
+    .from(ghostNumbersTable)
+    .where(
+      and(
+        eq(ghostNumbersTable.status, "active"),
+        or(
+          eq(ghostNumbersTable.msisdn, msisdn),
+          sql`${ghostNumbersTable.archivedMsisdns} @> ${JSON.stringify([msisdn])}::jsonb`,
+        ),
+      ),
+    );
+  return number;
+}
