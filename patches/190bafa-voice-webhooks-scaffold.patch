+// POST /api/webhooks/voice/answer — Vonage's Answer URL, hit the instant a
+// call reaches a ghost number. Must respond with an NCCO (Vonage's
+// call-control JSON) describing what to do with the call — returning an
+// error or empty body leaves the caller on dead air.
+//
+// Actual call routing (forward to the owner's real number, voicemail, or
+// bridge into this app's own WebRTC calling) isn't decided yet — that's a
+// product call, not just a technical one, and changes what gets built here.
+// This scaffold announces the number doesn't take calls yet and notifies
+// the owner in-app that someone tried, so the webhook plumbing is live and
+// testable end-to-end before the real routing behavior is built on top.
+//
+// Accepts both GET and POST since Vonage's Application config decides which
+// method it calls the Answer URL with, and params can land in the query
+// string or the body depending on that setting.
+const voiceAnswerHandler = async (req: Request, res: Response) => {
+  const params = { ...req.query, ...req.body } as { to?: string; from?: string };
+  const { to, from } = params;
+
+  try {
+    if (to) {
+      const number = await findActiveNumberByMsisdn(to);
+      if (number) {
+        broadcastToAlias(number.userId, {
+          type: "voice_call_missed",
+          from: from ?? "unknown",
+          to,
+        });
+        logger.info({ to, from, userId: number.userId }, "Inbound voice call to ghost number");
+      }
+    }
+  } catch (err) {
+    logger.error({ err, to, from }, "Voice answer webhook lookup failed");
+    // Fall through — still return valid NCCO below so the caller doesn't
+    // hit dead air just because the in-app notification failed.
+  }
+
+  return res.json([
+    {
+      action: "talk",
+      text: "This number does not accept voice calls yet. Please send a text message instead.",
+    },
+  ]);
+};
+router.get("/webhooks/voice/answer", voiceAnswerHandler);
+router.post("/webhooks/voice/answer", voiceAnswerHandler);
+
+// POST /api/webhooks/voice/events — Vonage's Event URL, posts call status
+// changes (ringing, answered, completed, etc.) throughout the call's
+// lifecycle. Nothing acts on these yet; logged for visibility while the
+// call-routing design above is still undecided. Vonage expects a bare 200
+// regardless of body.
+router.post("/webhooks/voice/events", (req: Request, res: Response) => {
+  logger.debug({ body: req.body }, "Voice call event");
+  res.status(200).end();
+});
+
