# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# Native build artifacts (generated by `expo prebuild`/`expo run:ios`) — also
# listed in artifacts/ghostface/.gitignore, but repeated here at root too:
# some tools (e.g. `railway up`'s file walker) only read the top-level
# .gitignore, not nested ones, and without this artifacts/ghostface/ios/'s
# ~1.6GB of CocoaPods symlinks made `railway up` hang for 20+ minutes
# indexing a directory that should never leave this machine anyway.
artifacts/ghostface/ios/
artifacts/ghostface/android/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Per-machine Claude Code permissions — local to each checkout, not shared
.claude/settings.local.json

# Replit
.cache/
.local/

# Env files (never commit secrets)
.env
.env.*
!.env.example
*.certSigningRequest
